@model IEnumerable<laba1.Models.Workout>

<h2>Пагинация</h2>

<table class="table">
    <tr>
        <th>Название</th>
        <th>Калории</th>
    </tr>

    @foreach (var w in Model)
    {
        <tr>
            <td>@w.Name</td>
            <td>@w.Calories</td>
        </tr>
    }
</table>

<div>
    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        <a asp-action="Paginated" asp-route-page="@i">@i</a>
    }
</div>